# ── Dépendances ─────────────────────────────────────────────────────────────────
node_modules/

# ── Build app desktop (binaires lourds — jamais dans git, produits par la CI) ────
desktop/dist/
desktop/dist*/
desktop/release/

# ── Secrets (NE JAMAIS committer) ───────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

# ── Profils Chrome (persistance cookies Puppeteer) ──────────────────────────────
.chrome_profile_*/

# ── Caches disque (régénérés automatiquement au démarrage) ──────────────────────
cache_*.json
news_history.json

# ── Miroir local des comptes (repli auth si Supabase bloqué) — CONTIENT DES HASH bcrypt ─────────
# Ne JAMAIS committer. En prod il vit dans DATA_DIR (volume Docker), ici on couvre aussi la racine (dev).
users_mirror.json
users_pending.json

# ── Logs ────────────────────────────────────────────────────────────────────────
*.log
server_out.txt
server_err.txt
server_out.log
server_err.log
server_debug.log

# ── Divers ──────────────────────────────────────────────────────────────────────
*.db
data/

# Render / local secrets & settings
.env.render
.claude/
apercu-email-reengagement.html
_tmpserve.js

# Caches PDF d execution (proxy/rendu des rapports de banques) : regeneres a la demande,
# volumineux et sans valeur en historique. Ils s etaient glisses dans un commit le 20/08.
pdf_cache/
render_pdf/

# Pages de controle locales (bancs de rendu). Jamais livrees.
.banc/

# Sauvegardes chiffrees et phrase secrete : JAMAIS dans le depot.
_sauvegarde-dtp/

# Repertoires de travail crees par des agents d audit (bancs cp/rsync, leurres de certificats).
# Ils ne doivent JAMAIS entrer dans le depot : un `git add -A` les a emportes une fois le 21/08.
cptest/
cptest2/
gtest/
*test/dest*/

# Bancs de mesure jetables ecrits a la racine par les agents d audit : ils ne sont pas
# du produit, et un `git add -A` les emporterait sans qu on le voie (arrive le 29/08 :
# six fichiers .tactile-audit*.js partis en production).
/.tactile-audit*.js
/.audit-*.js
# ⚠️ ET LA MEME CHOSE AVEC UN SOULIGNE, parce que la regle ci-dessus ne couvrait QUE le point
# initial (28/08 : deux `_audit-*-tmp.js` laisses a la racine par une sonde d audit, signales par
# le controle de fin de tache). Un banc jetable s ecrit a la racine quand il ouvre un navigateur :
# `puppeteer-core` ne se resout que depuis la, donc /tmp n est pas une option. La convention de
# nommage a glisse du point au souligne au fil des sessions, et le garde-fou n a pas suivi — un
# caractere d ecart entre « couvert » et « parti en production ». On couvre les deux graphies,
# ancrees a la RACINE pour ne rien avaler dans les sous-dossiers.
/_audit-*.js
/_taux-*.js
/_mesure-*.js
/_*-tmp.js

# ── Planche d'aperçu téléphone (image produite par scripts/mobile-apercu.js) ─────
apercu-mobile*.png
mobile/node_modules/
